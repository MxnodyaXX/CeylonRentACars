# Copy to .env.local and fill in the SAME Supabase project the MRAC Management System uses.
# The landing page reads the vehicles chosen on MRAC's "Website" page.
# Leave empty to show the built-in sample vehicles.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon/publishable key>
